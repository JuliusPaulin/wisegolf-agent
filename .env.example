# WiseGolf login credentials (used by browser-login and REST auth)
WISEGOLF_USERNAME=your.email@example.com
WISEGOLF_PASSWORD=your-password

# Bearer token (auto-managed by browser-login and club switch; or paste manually)
WISEGOLF_TOKEN=

# Club instance slug — drives api host (api.{slug}.fi)
WISEGOLF_HOST_SLUG=espoogolf

WISEGOLF_COURSE_ID=28
# Member numbers (memberNO) — what user provided
WISEGOLF_MEMBER_IDS=16968,16899
# Person ids — internal API ids; resolve via `wisegolf players` command
WISEGOLF_PERSON_IDS=37105,37125

# Booking horizon (days ahead bookable). Confirm via /reservations/calendarsettings
WISEGOLF_HORIZON_DAYS=14

SNIPE_TIME_LOCAL=10:00
SNIPE_TZ=Europe/Helsinki

ANTHROPIC_API_KEY=
LOG_LEVEL=INFO

# Phone notifications (scout watch)
# Option A: ntfy.sh — free, no account. Install app: https://ntfy.sh
#   Pick any unique topic string (acts as your private channel)
WISEGOLF_NTFY_TOPIC=

# Option B: Pushover — $5 app, very reliable. https://pushover.net
WISEGOLF_PUSHOVER_TOKEN=
WISEGOLF_PUSHOVER_USER=
